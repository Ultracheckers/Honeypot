FROM arm64v8/ubuntu:jammy

# Prevent interactive prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies
RUN apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        python3-dev \
        python3-pip \
        python3-virtualenv \
        build-essential \
        libssl-dev \
        libffi-dev \
        libpcap0.8-dev \
        sudo \
        procps \
        vim && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Set up working directory
WORKDIR /opt/opencanary

# Create and activate virtual environment
RUN virtualenv env/
ENV PATH="/opt/opencanary/env/bin:$PATH"

# Install OpenCanary and dependencies
RUN pip install opencanary scapy pcapyplus pymongo

# Create necessary directories
RUN mkdir -p /var/tmp /etc/opencanaryd
COPY opencanary.conf /etc/opencanaryd/opencanary.conf
RUN ln -sf /etc/opencanaryd/opencanary.conf /root/.opencanary.conf

# Copy configuration file (optional - can be managed by sync script)
# COPY opencanary.conf /etc/opencanaryd/opencanary.conf
# RUN ln -sf /etc/opencanaryd/opencanary.conf /root/.opencanary.conf

# Create log file and set permissions
RUN touch /var/tmp/opencanary.log && \
    chmod 666 /var/tmp/opencanary.log

# Copy sync script
COPY opencanary_sync.py /opt/opencanary/
RUN chmod +x /opt/opencanary/opencanary_sync.py

COPY start_opencanary.sh stop_opencanary.sh check_opencanary.sh /opt/opencanary/
RUN chmod +x /opt/opencanary/start_opencanary.sh /opt/opencanary/stop_opencanary.sh

# Expose commonly used honeypot ports
# Modify according to your enabled services in the config
EXPOSE 21 22 23 80 443 445 1433 3306 5432 8080

# Create entrypoint script
RUN echo '#!/bin/bash\n\
source /opt/opencanary/env/bin/activate\n\
# Start our sync script instead of OpenCanary directly\n\
python3 /opt/opencanary/opencanary_sync.py\n\
' > /entrypoint.sh && \
chmod +x /entrypoint.sh

# Start sync script on container launch (which manages OpenCanary)
ENTRYPOINT ["/entrypoint.sh"]